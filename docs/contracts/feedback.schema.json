{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:discoverphysics:feedback:1.0.0",
  "title": "参赛者成绩反馈格式契约",
  "description": "只公开总分和本次所选宇宙合计分，不允许附带分项、逐声明正确性、误差、评分日志或内部真值。总分须由各宇宙分数按既定档位权重计算；该算术关系由反馈生成端核对，JSON Schema只校验形状与数值范围。",
  "x-contract-version": "1.0.0",
  "x-number-policy": "使用标准JSON有限数值；生成端禁止NaN/Infinity，不通过显示舍入改变内部排名和节约资格判断。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "total_score",
    "world_scores"
  ],
  "properties": {
    "total_score": {
      "description": "按一级30%、二级40%、三级30%汇总；本次每档一个宇宙。",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "world_scores": {
      "description": "每宇宙只报告预言、定律与节约相加后的总分。现行配置只返回Tabris、Ramiel、Leliel；九宇宙分数字段形式仅兼容完整历史结果，不补零。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Adam": {
          "$ref": "#/$defs/world_score"
        },
        "Lilith": {
          "$ref": "#/$defs/world_score"
        },
        "Tabris": {
          "$ref": "#/$defs/world_score"
        },
        "Sachiel": {
          "$ref": "#/$defs/world_score"
        },
        "Ramiel": {
          "$ref": "#/$defs/world_score"
        },
        "Matriel": {
          "$ref": "#/$defs/world_score"
        },
        "Leliel": {
          "$ref": "#/$defs/world_score"
        },
        "Arael": {
          "$ref": "#/$defs/world_score"
        },
        "Lilin": {
          "$ref": "#/$defs/world_score"
        }
      },
      "oneOf": [
        {
          "required": [
            "Tabris",
            "Ramiel",
            "Leliel"
          ],
          "minProperties": 3,
          "maxProperties": 3
        },
        {
          "required": [
            "Adam",
            "Lilith",
            "Tabris",
            "Sachiel",
            "Ramiel",
            "Matriel",
            "Leliel",
            "Arael",
            "Lilin"
          ],
          "minProperties": 9,
          "maxProperties": 9
        }
      ]
    }
  },
  "$defs": {
    "world_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
