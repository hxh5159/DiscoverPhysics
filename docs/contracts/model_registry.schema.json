{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shore:model-registry:1.0.0",
  "title": "攻坚组模型权重路径清单",
  "description": "所有智能体使用的底座、完整训练检查点与适配器均须列出。相对路径以本清单所在目录为基准。唯一ID和主模型绑定关系由rift/strategy.py校验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "primary_model_id",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "primary_model_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "description": "模型绑定的唯一ID，多个智能体可共享一个ID，也可各自引用不同训练结果。"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "base_model",
          "path"
        ],
        "properties": {
          "base_model": {
            "type": "string",
            "enum": [
              "Qwen3.8-27B",
              "GLM-4.7-Flash",
              "Qwen3.6-35B-A3B",
              "Kimi-Linear-48B-A3B-Instruct",
              "GLM-4.5-Air-FP8",
              "Qwen3.5-122B-A10B-FP8",
              "DeepSeek-V4-Flash",
              "MiniMax-M2.5",
              "Qwen3.5-397B-A17B-FP8",
              "Qwen3.6-35B-A3B-FP8",
              "Qwen-3.6-35B-A3B-FP8",
              "Qwen3.5-122B-A10B",
              "Qwen3.5-397B-A17B",
              "27b",
              "35b",
              "35b-fp8",
              "122b",
              "122b-fp8",
              "397b",
              "397b-fp8"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "项目内POSIX相对路径，或实例中实际存在的Linux绝对模型路径，如/inspire/...。不得含..、反斜线、冒号或重复分隔符。路径格式检查不会加载模型；--check-files才检查实际文件，旧/models/...保留兼容。"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "adaptation": {
            "enum": [
              "base",
              "quantized",
              "sft",
              "rl",
              "other"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "description": "模型绑定的唯一ID，多个智能体可共享一个ID，也可各自引用不同训练结果。"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "该权重的用途说明，如实验规划或规律推断；不限定智能体数量。"
          },
          "adapter_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "可选LoRA/PEFT适配器目录；path仍指完整底座，adapter_path指对应适配器。"
          }
        }
      }
    }
  }
}
